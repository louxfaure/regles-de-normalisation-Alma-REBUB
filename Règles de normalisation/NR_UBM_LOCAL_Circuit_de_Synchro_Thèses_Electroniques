rule "Thèses accessibles"
priority 5
when
    ((exists "856.u") AND (not exists "310.a") AND (not exists "371.a") AND (not exists "856.z.Acc*s r*serv* au texte int*gral")  AND (not exists "856.z.*version partielle"))
then
    copyField "856.u" to "LIE.a"  if (exists "856.q")
end

rule "Thèses en accès intranet"
priority 6
when
    (exists "856.5.335229906*")
then
    addField "NOT.a.<p class='alert'><strong>Thèse en accès limité</strong> accessible à distance <b>sur authentification pour les membres de l’Université Bordeaux Montaigne</b>,ou <b>sur place sur les ordinateurs disponibles dans les bibliothèques (campus de Pessac)</b>.</p><p class='info'>L’ensemble de la collection des thèses de l’Université Bordeaux Montaigne a été numérisée et est accessible au format numérique. Vous êtes docteur de notre université et avez des questions sur la diffusion de votre thèse ? Nous serons ravis d’y répondre : <a href='https://extranet.u-bordeaux-montaigne.fr/rita_fo/?num_cg=59&num_form=1'>contactez-nous</a>.</p>"
    copyField "856.u" to "LIE.a"
end

#Cas des thèses sous embargo
rule "Thèses sous embargo"
priority 8
when
    ((exists "310.a.*embargo*") OR (exists "371.a.*embargo*"))
then
      copyField "310.a" to "NOT.a"  if (exists "310.a")
      copyField "371.a" to "NOT.a"  if (exists "371.a")
      suffix "NOT.a" with ". <strong>Consultation à distance réservée aux membres de la communauté universitaire. <a href=https://www.u-bordeaux-montaigne.fr/fr/documentation/informations-pratiques/diffuser-sa-these.html'>En savoir plus</a></strong></p>"
      prefix "NOT.a" with "<p class='alert'>"
      copyField "033.a" to "LIE.a"  if (exists "033.a")
      suffix "LIE.a" with "/document"
end

#Cas des thèses confidentielles
rule "Thèses confidentielles"
priority 9
when
    ((exists "310.a.*confidentielle*") OR (exists "371.a.*confidentielle*"))
then
      copyField "310.a" to "NOT.a"  if (exists "310.a")
      copyField "371.a" to "NOT.a"  if (exists "371.a")
      suffix "NOT.a" with ". <strong>Pas d’accès</strong></p>"
      prefix "NOT.a" with "<p class='alert'>"
      copyField "033.a" to "LIE.a"  if (exists "033.a")
end

#Cas des thèses partielles
rule "Thèses partielles"
priority 10
when
    ((exists "856.z.* version partielle"))
then
      addField "NOT.a.<p class='alert'>Accès au texte intégral de la <strong>version partielle</strong>. La version complète est <strong>consultable sur place à l’Université Bordeaux Montaigne</strong></p>"
      copyField "856.u" to "LIE.a"  if (exists "856.z.*version partielle")
end
